#!/bin/bash

declare -A COLORS=(
    [Red]='\033[1;31m'
    [Green]='\033[1;32m'
    [Yellow]='\033[1;33m'
    [Blue]='\033[1;34m'
    [Cyan]='\033[1;36m'
    [NoColor]='\033[0m'
)

if [[ "$(uname -s)" != "Linux" ]]; then
    echo -e "${COLORS[Red]}Error: This script is designed for Linux.${COLORS[NoColor]}"
    exit 1
fi

if [[ -z "$ZSH_VERSION" && -z "$BASH_VERSION" ]]; then
    echo -e "${COLORS[Red]}Error: Please use Bash or ZSH.${COLORS[NoColor]}"
    exit 1
fi

export DOTNET_CLI_TELEMETRY_OPTOUT=1

if [ -z "$LC_ALL" ] && [ -z "$LANG" ]; then
    export LANG=C.utf8
    export LC_ALL=$LANG
elif [ -z "$LANG" ]; then
    export LANG=$LC_ALL
elif [ -z "$LC_ALL" ]; then
    export LC_ALL=$LANG
fi

POSH_THEME="$HOME/.poshthemes/default.omp.json"

export HOST_LC_ALL="$LC_ALL"
export WINEDLLPATH=$WINEDLLPATH:/opt/discord-rpc/bin64:/opt/discord-rpc/bin32

if [[ -S "${XDG_RUNTIME_DIR}/docker.sock" ]]; then
    export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
elif [[ -S "/var/run/docker.sock" ]]; then
    export DOCKER_HOST="unix:///var/run/docker.sock"
fi

function rootless_docker {
	export DOCKER_HOST="unix:///var/run/docker.sock"
}

function root_docker {
	export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
}

if [[ -f "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

function isWSL() {
    local unameout
    unameout=$(uname -r | tr '[:upper:]' '[:lower:]')
    if [[ "$unameout" == *microsoft* || "$unameout" == *wsl* ]] ||
       [[ -f /proc/sys/fs/binfmt_misc/WSLInterop ]] ||
       [[ -n "$WSL_DISTRO_NAME" ]]; then
        return 0
    fi
    return 1
}

function UpdateAlias() {
    echo -e "${COLORS[Blue]}Updating aliases...${COLORS[NoColor]}"
    wget -qO "$HOME/.alias.ps1" "https://raw.githubusercontent.com/herrwinfried/myconfig/linux/data/user/.alias.ps1"
    wget -qO "$HOME/.alias" "https://raw.githubusercontent.com/herrwinfried/myconfig/linux/data/user/.alias"
    echo -e "${COLORS[Green]}Aliases updated.${COLORS[NoColor]}"
}

function prepend_sudo() {
    if [[ -n "$BASH_VERSION" ]]; then
        [[ $READLINE_LINE == "sudo "* ]] && READLINE_LINE=${READLINE_LINE#sudo } || READLINE_LINE="sudo $READLINE_LINE"
    else
        [[ $LBUFFER == "sudo "* ]] && LBUFFER=${LBUFFER#sudo } || LBUFFER="sudo $LBUFFER"
    fi
}
NowShell=""
if [[ -n "$BASH_VERSION" ]]; then
    NowShell="bash"
    SHELL_PLUGIN_DIRS=("$HOME/.$NowShell/plugins" "/usr/local/share" "/usr/share")
    SHELL_PLUGIN_NAMES=()
    [[ -s "/etc/${NowShell}_command_not_found" ]] && . "/etc/${NowShell}_command_not_found"
    bind -x '"\es": prepend_sudo'
elif [[ -n "$ZSH_VERSION" ]]; then
    NowShell="zsh"
    SHELL_PLUGIN_DIRS=("$HOME/.$NowShell/plugins" "/usr/local/share" "/usr/share")
    SHELL_PLUGIN_NAMES=("zsh-autocomplete" "zsh-autosuggestions" "zsh-syntax-highlighting" "zsh-completions")
    [[ -s "/etc/${NowShell}_command_not_found" ]] && . "/etc/${NowShell}_command_not_found"
    zle -N prepend_sudo
    bindkey '^[s' prepend_sudo
fi

if command -v zypper >/dev/null 2>&1; then
    function zypp-history() {
        sudo bash -c 'cut -d "|" -f 1-4 -s --output-delimiter " | " /var/log/zypp/history | grep -v " radd "'
    }
fi

function PluginInstall() {
    [[ -z "${SHELL_PLUGIN_NAMES[*]}" ]] && return

    for PluginName in "${SHELL_PLUGIN_NAMES[@]}"; do
        local found=0
        for Folder in "${SHELL_PLUGIN_DIRS[@]}"; do
            local file=""
            [[ -n "$BASH_VERSION" ]] && file=$(ls "$Folder/$PluginName/$PluginName.plugin.bash" "$Folder/$PluginName/$PluginName.plugin.sh" 2>/dev/null | head -n 1)
            [[ -n "$ZSH_VERSION" ]] && file="$Folder/$PluginName/$PluginName.plugin.zsh"

            if [[ -f "$file" ]]; then
                source "$file"
                found=1
                break
            fi
        done

        if [[ $found -eq 0 ]]; then
            echo -e "${COLORS[Blue]}[$NowShell]${COLORS[NoColor]} ${COLORS[Yellow]}Plugin Not Found:${COLORS[NoColor]} '${COLORS[Red]}$PluginName${COLORS[NoColor]}'"
        fi
    done
}

PluginInstall

if command -v oh-my-posh >/dev/null 2>&1 && [[ -f "$POSH_THEME" ]]; then
    [[ "$TERM" != "linux" ]] && eval "$(oh-my-posh init $NowShell --config $POSH_THEME)"

    function UpdateOhMyPoshTheme() {
        echo -e "${COLORS[Blue]}Updating Oh My Posh theme...${COLORS[NoColor]}"
        wget -qO "$POSH_THEME" "https://raw.githubusercontent.com/herrwinfried/myconfig/linux/data/user/.poshthemes/default.omp.json"
        echo -e "${COLORS[Green]}Theme updated.${COLORS[NoColor]}"
    }
fi

unset NowShell